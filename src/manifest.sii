SiiNunit
{
mod_package : .package_name
{
	package_version: "{{version}}"
	display_name: "{{display_name}}{{part_label}}"
	author: "DevilDogTG"
	category[]: "graphics"
	category[]: "weather_setup"
	category[]: "ai_traffic"
	category[]: "sound"
	icon: "cover.jpg"
	description_file: "description.txt"

	mp_mod_optional: true
}
}
