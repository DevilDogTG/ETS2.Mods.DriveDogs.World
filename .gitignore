# build output — never commit
output/
build/

# optional junctions into the extracted-reference root
sources/

# python
__pycache__/
*.pyc

# in-game test logs (game.log copies from test sessions)
logs/

# generated by tools/rain_reflections.py (road normal maps with puddles, ~70 MB): rerun the tool after a clone
overrides/material/road/road_template/**/*_nrm.dds

# generated by tools/bus_stop_people.py (base-game bus-stop models with Workshop 2893480838's locators): rerun the
# tool after a clone
overrides/prefab/**/*.pmg
overrides/prefab2/**/*.pmg
